# PoC Verifier configuration — copy to .env and fill in real values.
# .env is gitignored; never commit secrets. See PROJECT_PLAN.md §3.
#
# In Azure these become App Service / Container Apps app settings;
# keys and certificates move to Key Vault references.

# Port the Express server listens on.
PORT=3000

# REQUIRED. Public base URL of this verifier — the wallet must be able to
# reach it (HTTPS in any real test, e.g. an ngrok/cloudflared tunnel URL).
# Used to build response_uri and to derive CLIENT_ID when unset.
# BASE_URL=https://your-tunnel.example.com

# Verifier client_id sent in the authorization request.
# Defaults to the BASE_URL hostname. HAIP deployments use
# x509_san_dns:<host> once a verifier certificate exists.
# CLIENT_ID=

# Session lifetime for an authorization request (milliseconds).
SESSION_TTL_MS=300000

# Comma-separated mDL claims to request (namespace org.iso.18013.5.1 is
# added automatically by the library's buildHaipQuery).
MDL_CLAIMS=family_name,given_name,birth_date,age_over_18,portrait

# Directory with trusted issuer certificates (*.der / *.pem).
TRUSTED_ISSUERS_DIR=./trusted-issuers

# --- Later (Azure / JAR / encrypted responses, not used by the PoC yet) ---
# VERIFIER_SIGNING_KEY=          # path to PEM; in Azure: Key Vault reference
# VERIFIER_ENCRYPTION_KEY=       # path to PEM; in Azure: Key Vault reference
# KEYVAULT_URI=                  # switches trusted-issuer loading to Key Vault
